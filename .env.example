# Deploy-time config. Read by `docker compose` interpolation in docker-compose.yml.
#
# This file matters ONLY on the machine that runs `docker compose up` (the
# self-hosted deploy runner). On a dev laptop it is unused — dev config lives in
# apps/api/.env and apps/web/.env, which each app's dev server loads directly.
#
# Compose cannot read apps/*/.env: it only auto-loads the .env beside the compose
# file, and the VITE_* vars below are `build.args`, consumed by the Docker build
# rather than the container. Hence the separate file.
#
# Copy to .env and fill in. Every var below uses `${VAR:?}` in compose, so a
# missing value fails the deploy loudly instead of shipping a broken image.

# --- api (container env, secret) ---
MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/moviev2
TOKEN_KEY=

# --- web (build args) ---
# WARNING: build args are baked into the shipped JS bundle and are publicly
# readable from the deployed site. Never put a real secret here, and never give a
# secret a VITE_ prefix — that is the one typo that turns MONGO_URI or TOKEN_KEY
# into public data.
VITE_APP_API_BASE_URL=https://api.themoviedb.org/3/
VITE_APP_TMDB_API_KEY=

# Optional. Build stamp; defaults to empty via ${APP_COMMIT:-}.
APP_COMMIT=
