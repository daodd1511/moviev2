# LOCAL config, read by `docker compose` interpolation in docker-compose.yml.
#
# Production does not use this file. CI builds the images (VITE_* values come from
# GitHub Actions variables on this repo) and the private deploy repo runs them on the
# server, reading its own /srv/moviev2/.env for MONGO_URI, TOKEN_KEY and TUNNEL_TOKEN.
#
# This file is only for `docker compose up` on a dev machine, which still builds both
# images locally. Running the apps without Docker uses apps/api/.env and
# apps/web/.env instead — compose cannot read those, since it only auto-loads the
# .env beside the compose file, and the VITE_* vars below are `build.args` consumed
# by the Docker build rather than by the container.
#
# Copy to .env and fill in. Every var below uses `${VAR:?}` in compose, so a missing
# value fails loudly instead of producing a broken image.

# --- api (container env, secret) ---
MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/moviev2
TOKEN_KEY=

# --- web (build args) ---
# WARNING: build args are baked into the shipped JS bundle and are publicly
# readable from the deployed site. Never put a real secret here, and never give a
# secret a VITE_ prefix — that is the one typo that turns MONGO_URI or TOKEN_KEY
# into public data. The production equivalents live as GitHub Actions *variables*,
# not secrets, for the same reason.
VITE_APP_API_BASE_URL=https://api.themoviedb.org/3/
VITE_APP_TMDB_API_KEY=

# Optional. Build stamp; defaults to empty via ${APP_COMMIT:-}.
APP_COMMIT=
