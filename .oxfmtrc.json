{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "ignorePatterns": [".claude/**", ".impeccable/**"],
  "sortImports": false,
  "sortPackageJson": false,
  "overrides": [
    {
      "files": ["apps/web/**/*.{js,jsx,ts,tsx,css,html}"],
      "options": {
        "sortTailwindcss": {
          "stylesheet": "apps/web/src/index.css",
          "functions": ["cn", "clsx", "cva"]
        }
      }
    }
  ]
}
