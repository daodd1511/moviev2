# Local dev config for the express API. Loaded by dotenv.config() in index.js,
# which resolves relative to this directory — so this file must live here, not at
# the repo root.
#
# Not used in production: docker-compose.yml passes these as container env from
# the root .env instead.
#
# Copy to .env and fill in. Without it, mongoose fails to connect and jwt.sign in
# src/service/authService.js throws on login.

# Use a dev database, NOT the production cluster.
MONGO_URI=mongodb://localhost:27017/moviev2

# Any non-empty string. Keep it different from the production TOKEN_KEY —
# sharing one means tokens signed on your laptop are valid against prod.
TOKEN_KEY=dev-only-not-a-real-secret

PORT=4000

# Comma-separated allowlist of origins allowed to call the API. Defaults to
# http://localhost:3000 (the web app's Vite dev server) when unset.
CORS_ORIGINS=http://localhost:3000

# TMDB v3 API key (https://www.themoviedb.org/settings/api). Without it, every
# /api/catalog request returns 503 catalog_unavailable.
TMDB_API_KEY=

# Base URL for the TMDB API. Defaults to https://api.themoviedb.org/3 when unset.
# Override it with a proxy that mirrors TMDB's v3 paths when the network between
# this API and TMDB blocks api.themoviedb.org, which surfaces as 502
# catalog_unavailable. The API key is sent to whatever host is configured here,
# so only point this at a proxy you control.
TMDB_BASE_URL=
