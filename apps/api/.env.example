# Local dev config for the express API. Loaded by dotenv.config() in index.js,
# which resolves relative to this directory — so this file must live here, not at
# the repo root.
#
# Not used in production: docker-compose.yml passes these as container env from
# the root .env instead.
#
# Copy to .env and fill in. Without it, mongoose fails to connect and jwt.sign in
# src/service/authService.js throws on login.

# Use a dev database, NOT the production cluster.
MONGO_URI=mongodb://localhost:27017/moviev2

# Any non-empty string. Keep it different from the production TOKEN_KEY —
# sharing one means tokens signed on your laptop are valid against prod.
TOKEN_KEY=dev-only-not-a-real-secret

PORT=4000
