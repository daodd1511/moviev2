# Local dev config for the React SPA. Loaded by Vite, which resolves env files
# from its project root — so this file must live here, not at the repo root.
#
# Not used in production: docker-compose.yml passes these as build args from the
# root .env instead.
#
# Copy to .env and fill in. Keys are typed in src/vite-env.d.ts.

# TMDB. Both values ship in the client bundle by design and are publicly
# readable — this is not a place for secrets.
VITE_APP_API_BASE_URL=https://api.themoviedb.org/3/
VITE_APP_TMDB_API_KEY=

# Which backend the dev server talks to. As currently configured this points at
# the DEPLOYED api, so `npm run dev:web` alone is enough to work on the frontend.
# Switch to http://localhost:4000/api to run against a local `npm run dev:api`
# (which needs apps/api/.env). In production this is /api — same-origin, proxied
# by nginx.
VITE_APP_BACKEND_API_URL=https://api.movie.thomasduong.info.vn/api/

VITE_APP_IS_PRODUCTION=false
