{
  "name": "moviev2",
  "private": true,
  "description": "Movie browser: React SPA (apps/web) + express API (apps/api), deployed as one stack.",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @movie/web dev",
    "dev:api": "pnpm --filter @movie/api dev",
    "build": "pnpm --filter @movie/web build",
    "build:web": "pnpm --filter @movie/web build",
    "typecheck": "pnpm --filter @movie/web exec tsc --noEmit",
    "lint": "pnpm --filter @movie/web lint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "volta": {
    "node": "22.20.0"
  },
  "devDependencies": {
    "oxfmt": "0.60.0"
  }
}
